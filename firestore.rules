rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // profilo: solo il proprietario
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // stanze e tutte le sottocollezioni (players, tiles, attacks, trades, confs):
    // il gioco è "client-authoritative", quindi ogni utente autenticato deve poter scrivere
    match /rooms/{room=**} {
      allow read, write: if request.auth != null;
    }
  }
}
